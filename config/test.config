server {
    listen 8080;
    server_name myserver;

    root www;
    index index.html;
    autoindex autoindex;

    error_page 404 /errors/404.html;
    client_max_body_size 4784984894;

    location / {
        root www;
        index index.html;
        autoindex off;
        methods GET POST;
    }

    location /files {
        root /home/ibennaje/Desktop/webserve;
        autoindex on;
        methods GET;
    }

    location /upload {
        upload_store uploads;
        client_max_body_size 5000000;
        methods POST;
    }

    location /cgi-bin {
        root cgi-bin;
        cgi_extension .py;
        cgi_pass /usr/bin/python3;
        methods GET POST;
    }

#    location /redirect {
#        return 301 http://example.com;
#    }
}


