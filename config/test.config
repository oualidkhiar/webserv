server {
    listen 8080;

    server_name localhost;

    root /var/www/site1;
    index index.html index.htm;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;

    client_max_body_size 5M;

    location / {
        allow_methods GET POST;
    }

    location /upload {
        allow_methods POST;
        upload_store /var/www/uploads;
    }

    location /images {
        allow_methods GET;
        autoindex on;
    }

    location /old {
        return 301 /new;
    }

    location /cgi-bin {
        allow_methods GET POST;
        cgi_extension .py;
        cgi_path /usr/bin/python3;
    }
}

server {
    listen 9090;
    server_name example.com www.example.com;

    root /var/www/site2;
    index home.html;

    error_page 403 /errors/403.html;

    client_max_body_size 1M;

    location / {
        allow_methods GET;
    }

    location /videos {
        allow_methods GET;
        autoindex off;
    }
}
