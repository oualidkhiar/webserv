

The FD is an index that the kernel uses to find a struct file in kernel memory.
The struct file is a generic kernel object used for files, sockets, pipes… and system calls cause CPU mode switch so the kernel can operate on it.


        struct file is used by the kernel to unify:

        regular files

        directories

        pipes

        sockets

        devices

        etc.

        All of them share the same abstraction: “file”

-------------------------------------------------------------------------------------------------
        process_fd_table[3] → pointer to struct file (in kernel space)


        --> struct file is in kernel memory, invisible to user space.

        struct file
        {
            mode_t        f_mode;          // read/write/append/truncate flags
            loff_t        f_pos;           // current offset in file
            const struct  file_operations *f_op; // function pointers for read/write
            struct path   f_path;          // contains pointer to inode + mount point
            atomic_t      f_count;         // reference count
            void         *private_data;    // used by drivers/sockets
        };


                 struct file
        +----------------------------------+
        | f_mode          (R/W flags)      |
        | f_pos           (offset)         |
        | f_op ----------> file_operations |                    
        | f_path --------> (dentry, inode) |                
        | f_count         (ref count)      |                    
        | private_data    (drivers, etc.)  |                    
        +----------------------------------+

                EXACT Linux struct file definition From Linux 5.10+ (fs/file.h):

                struct file {
                    union {
                        struct llist_node    fu_llist;                          
                        struct rcu_head      fu_rcuhead;                            
                    } f_u;                                                      

                    struct path             f_path;                             
                    struct inode            *f_inode;   /* cached value */              
                    const struct file_operations *f_op;                         

                    spinlock_t              f_lock;                             
                    atomic_long_t           f_count;                            
                    unsigned int            f_flags;                            
                    fmode_t                 f_mode;                             
                    struct mutex            f_pos_lock;                         
                    loff_t                  f_pos;                                      
                    struct fown_struct      f_owner;                                    
                    struct cred             *f_cred;                                    
                    struct file_ra_state    f_ra;                                       

                    u64                     f_version;                                          

                #ifdef CONFIG_SECURITY                                                                  
                    void                    *f_security;                                                                
                #endif                                                                                  

                    void                    *private_data;                                                      
                    struct address_space    *f_mapping;                                         
                } __randomize_layout;                                                           
                        
                        
                        struct file
                        │
                        ├── f_u
                        │     ├── fu_llist       // free list (unused for normal use)
                        │     └── fu_rcuhead     // RCU cleanup
                        │
                        ├── f_path               // (dentry + mountpoint)
                        │     ├── dentry
                        │     └── vfsmount
                        │
                        ├── f_inode              // pointer to inode (cached)
                        │
                        ├── f_op                 // pointer to file operations table
                        │                        // (read, write, poll, ioctl...)
                        │
                        ├── f_lock               // protects struct file fields
                        │
                        ├── f_count              // reference count
                        │
                        ├── f_flags              // open flags (O_RDONLY, O_WRONLY, O_NONBLOCK...)
                        │
                        ├── f_mode               // file mode (read/write bits)
                        │
                        ├── f_pos_lock           // protects file offset
                        │
                        ├── f_pos                // current file position (like C's FILE*)
                        │
                        ├── f_owner              // owner used for async notifications
                        │
                        ├── f_cred               // credentials (UID, GID) of opener
                        │
                        ├── f_ra                 // readahead state
                        │
                        ├── f_version            // file version (changes on write)
                        │
                        ├── f_security           // security module data (SELinux, etc.)
                        │
                        ├── private_data         // ***THE MOST IMPORTANT FIELD***
                        │                        // used for:
                        │                        //   - sockets (struct socket)
                        │                        //   - pipes
                        │                        //   - char devices
                        │                        //   - block devices
                        │                        //   - special FS state
                        │
                        └── f_mapping            // memory mapping info (mmap)

